# Ignore everything by default
*

# Allow repository configuration and documentation
!.gitignore
!README.md
!AGENTS.md
!LICENSE
!skills.sh.json

# Allow skills directory
!skills/
!skills/**

# Allow .agents directory
!.agents/
!.agents/**

# Allow test suite
!tests/
!tests/**

# Allow core package code only
!universal_transcriber/
universal_transcriber/*
!universal_transcriber/universal_transcribe.py
!universal_transcriber/source_preparation.py
!universal_transcriber/source_sync.py
!universal_transcriber/manage_notebook.py
!universal_transcriber/build_docx.py
!universal_transcriber/config.example.json
!universal_transcriber/README.md

# Ignore Python caches, temp files, and local run caches
__pycache__/
*.py[cod]
*$py.class
*.orig
.transcriber-cache/
modules/**/.transcriber-cache/
.pytest_cache/

# Ignore local course data and modules
modules/
modules/**

