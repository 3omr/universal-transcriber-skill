# Ignore everything by default
*

# Allow repository configuration and documentation
!.gitignore
!README.md
!AGENTS.md
!LICENSE
!requirements.txt
# Ruff and mypy configuration (tooling only -- not a package definition).
!pyproject.toml
!skills.sh.json
# The single source of truth for the skill version (scripts/bump-version.sh).
!VERSION
!.github/
!.github/**

# Allow skills directory
!skills/
!skills/**

# Allow the .agents mirror (generated by scripts/sync-agents-mirror.sh)
!.agents/
!.agents/**

# Allow repository maintenance scripts
!scripts/
!scripts/**

# Allow test suite
!tests/
!tests/**

# Ignore Python caches, temp files, and local run caches
__pycache__/
*.py[cod]
*$py.class
*.orig
.transcriber-cache/
modules/**/.transcriber-cache/
.pytest_cache/

# Ignore local course data and modules
modules/
modules/**
